---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteStatus, formatChecked } from '../utils/status';
import { guideIndex } from '../data/navigation';
import { getGuideBySlug } from '../utils/content';
import { absoluteUrl } from '../utils/seo';

const status = await getSiteStatus();
const home = await getGuideBySlug('');
const numerals = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
---
<BaseLayout
  title="The Duskbloods: What We Know After the Network Test | Duskbloods Archive"
  description={home.data.description}
  canonical={absoluteUrl('/')}
  bodyClass="is-home"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Duskbloods Archive',
      url: 'https://duskbloodsarchive.com/',
      description: 'Unofficial English fan guide to The Duskbloods.'
    },
    {
      '@context': 'https://schema.org',
      '@type': 'VideoGame',
      name: 'The Duskbloods',
      gamePlatform: 'Nintendo Switch 2',
      author: { '@type': 'Organization', name: 'FromSoftware' }
    }
  ]}
>
  <section class="observatory">
    <div class="observatory-art">
      <img src="/images/official/moon-leap.jpg" alt="A Bloodsworn leaping above a gothic city under a pale moon. Official still from Nintendo." width="1400" height="788" fetchpriority="high" />
    </div>
    <div class="wrap observatory-copy">
      <p class="issue">A record of confirmed details, not a storefront.</p>
      <h1>The Duskbloods: What We Know After the Network Test</h1>
      <p class="lede">Confirmed details, test findings, and the road to release, without rumor presented as fact.</p>
    </div>
    <div class="wrap desk">
      <section class="panel" aria-labelledby="verified-heading">
        <p class="panel-kicker">Verified changes</p>
        <h2 id="verified-heading">The last three facts that moved</h2>
        <ol class="desk-facts">
          <li><time datetime="2026-08-23">23 Aug 2026</time><div>Published US sessions ended after the fifth PDT window.</div></li>
          <li><time datetime="2026-08-21">21 Aug 2026</time><div>First session closed early after game-server issues, according to reporting of FromSoftware's statement.</div></li>
          <li><time datetime="2026-08-20">20 Aug 2026</time><div>Nintendo denied a September 24 release date.</div></li>
        </ol>
      </section>

      <article class="panel panel-feature" id="current-status" aria-labelledby="status-heading">
        <img class="panel-feature-art" src="/images/official/station-fog.jpg" alt="A fogged station and tram street in the Lands of Dusk." width="1400" height="788" />
        <div class="panel-feature-copy">
          <p class="panel-kicker">Now</p>
          <h2 id="status-heading">{status.headline}</h2>
          <p>{status.summary}</p>
          <p class="folio-links">
            <a href="/network-test/">Open the recap</a>
            <a href="/gameplay/">Read the match flow</a>
          </p>
          <p class="unofficial">Official still via Nintendo of America. Lowanro City is the Network Test land. Checked {formatChecked(status.updatedAt)}. Source: <a href={status.sourceUrl} rel="noopener">{status.sourceLabel}</a>.</p>
        </div>
      </article>

      <section class="panel" aria-labelledby="from-test-heading">
        <p class="panel-kicker">From the test</p>
        <h2 id="from-test-heading">What the stills show</h2>
        <a class="desk-entry" href="/characters/">
          <img src="/images/official/ridge-hunters.jpg" alt="A rifle-bearing Bloodsworn standing over a kneeling swordsman against a red sky." width="280" height="158" />
          <span>
            <strong>Six Bloodsworn</strong>
            <span>Albert, Bloodhand Jan, Trang Lanh, Sniper Layla, Senator Samir Patres, and Zork.</span>
          </span>
        </a>
        <a class="desk-entry" href="/kin/">
          <img src="/images/official/kin-familiar.jpg" alt="A black winged familiar marked with glowing signs." width="280" height="158" />
          <span>
            <strong>Kin</strong>
            <span>Eight test-build Kin, summoned from Ring, Blade, or Eye.</span>
          </span>
        </a>
        <a class="desk-entry" href="/gameplay/">
          <img src="/images/official/great-foe.jpg" alt="Two Bloodsworn attacking a giant frog-like foe on a stone stair." width="280" height="158" />
          <span>
            <strong>Dusk Battle</strong>
            <span>Eight players, four phases, and a final three. The test uses one land: Lowanro City.</span>
          </span>
        </a>
      </section>
    </div>
  </section>

  <div class="wrap">
    <p class="colophon">
      <span><b>Platform</b> Nintendo Switch 2</span>
      <span><b>Developer</b> FromSoftware</span>
      <span><b>Release</b> 2026</span>
      <span><b>Images</b> Official stills via Nintendo of America</span>
    </p>
  </div>

  <section class="chapter">
    <div class="wrap">
      <p class="kicker reveal">Contents of the first edition</p>
      <h2 class="reveal">What this archive holds</h2>
      <ol class="contents reveal">
        {guideIndex.map((item, index) => (
          <li>
            <a href={item.href}>
              <span class="num">{numerals[index]}</span>
              <span>
                <strong>{item.title}</strong>
                <span>{item.summary}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="chapter">
    <div class="wrap">
      <p class="kicker reveal">How to read this desk</p>
      <h2 class="reveal">Four labels, used in public</h2>
      <div class="method reveal">
        <div><b>Confirmed</b><p>Nintendo or FromSoftware published it.</p></div>
        <div><b>Test-build only</b><p>True in the network test. Retail may change.</p></div>
        <div><b>Player-reported</b><p>Seen in the field. Not an official bulletin.</p></div>
        <div><b>Unconfirmed</b><p>Does not belong in a title or a summary.</p></div>
      </div>
    </div>
  </section>

<script is:inline>const root=document.documentElement;const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;if(!reduced&&'IntersectionObserver'in window){root.classList.add('motion-ok');const io=new IntersectionObserver((entries)=>{for(const entry of entries){if(entry.isIntersecting){entry.target.classList.add('in-view');entry.target.classList.remove('await-view');io.unobserve(entry.target);}else if(!entry.target.classList.contains('in-view')){entry.target.classList.add('await-view');}}}, {rootMargin:'0px 0px -12% 0px',threshold:0.08});for(const el of document.querySelectorAll('.reveal, .chapter, .ledger')){io.observe(el);}}</script>
</BaseLayout>
